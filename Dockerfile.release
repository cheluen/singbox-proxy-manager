FROM alpine:3.24 AS selector

ARG TARGETARCH

COPY release-binaries/ /tmp/release-binaries/

RUN ARCH="${TARGETARCH:-$(uname -m)}" \
    && case "${ARCH}" in \
      amd64|x86_64) ARCH="amd64" ;; \
      arm64|aarch64) ARCH="arm64" ;; \
      *) echo "Unsupported TARGETARCH: ${ARCH}" >&2; exit 1 ;; \
    esac \
    && cp "/tmp/release-binaries/singbox-proxy-manager-linux-${ARCH}" /tmp/singbox-proxy-manager \
    && chmod +x /tmp/singbox-proxy-manager

FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=selector /tmp/singbox-proxy-manager /app/singbox-proxy-manager
COPY LICENSE THIRD_PARTY_NOTICES.md USER_AGREEMENT.md /app/
COPY licenses/SING-BOX-GPL-3.0.txt /app/licenses/SING-BOX-GPL-3.0.txt
RUN mkdir -p /app/config /app/certs /app/keys

ENV PORT=30000
ENV BIND_ADDRESS=0.0.0.0
ENV CONFIG_DIR=/app/config
ENV TZ=Asia/Singapore
ENV SBPM_INBOUND_TLS_CERT_DIR=/app/certs
ENV SBPM_INBOUND_TLS_KEY_DIR=/app/keys
ENV ACCEPT_USER_AGREEMENT=false
ENV ADMIN_PASSWORD=
ENV SBPM_SINGBOX_LOG_OUTPUT=stdout
ENV SBPM_SINGBOX_LOG_MAX_BYTES=10485760
ENV SBPM_SINGBOX_LOG_BACKUPS=3
ENV DATABASE_URL=
ENV POSTGRES_DATABASE_URL=
ENV MYSQL_DATABASE_URL=
ENV PGSQL=
ENV MYSQL=
ENV MYSQL_DATABASE_NAME=
ENV TURSO_DATABASE_URL=
ENV TURSO_AUTH_TOKEN=
ENV SBPM_UPDATE_CHECK_DISABLED=false
ENV SBPM_UPDATE_CHECK_REPO=cheluen/singbox-proxy-manager
ENV SBPM_UPDATE_CHECK_TTL=6h
ENV SBPM_UPDATE_CHECK_TIMEOUT=5s

EXPOSE 30000
VOLUME ["/app/config"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/app/singbox-proxy-manager", "--healthcheck"]
CMD ["/app/singbox-proxy-manager"]
