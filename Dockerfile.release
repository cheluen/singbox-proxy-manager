FROM debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY release-binaries/ /app/release-binaries/

RUN ARCH="${TARGETARCH}" \
    && if [ -z "$ARCH" ]; then ARCH="$(dpkg --print-architecture)"; fi \
    && case "${ARCH}" in \
      amd64|arm64) BIN="/app/release-binaries/singbox-proxy-manager-linux-${ARCH}" ;; \
      *) echo "Unsupported TARGETARCH: ${ARCH}" >&2; exit 1 ;; \
    esac \
    && test -f "$BIN" \
    && cp "$BIN" /app/singbox-proxy-manager \
    && chmod +x /app/singbox-proxy-manager \
    && rm -rf /app/release-binaries \
    && mkdir -p /app/config

ENV PORT=30000
ENV BIND_ADDRESS=0.0.0.0
ENV CONFIG_DIR=/app/config
ENV TZ=UTC+8
ENV ADMIN_PASSWORD=
ENV SBPM_SINGBOX_LOG_OUTPUT=stdout
ENV SBPM_SINGBOX_LOG_MAX_BYTES=10485760
ENV SBPM_SINGBOX_LOG_BACKUPS=3
ENV DATABASE_URL=
ENV POSTGRES_DATABASE_URL=
ENV MYSQL_DATABASE_URL=
ENV PGSQL=
ENV MYSQL=
ENV MYSQL_DATABASE_NAME=
ENV TURSO_DATABASE_URL=
ENV TURSO_AUTH_TOKEN=
ENV SBPM_UPDATE_CHECK_DISABLED=false
ENV SBPM_UPDATE_CHECK_REPO=cheluen/singbox-proxy-manager
ENV SBPM_UPDATE_CHECK_TTL=6h
ENV SBPM_UPDATE_CHECK_TIMEOUT=5s

EXPOSE 30000
VOLUME ["/app/config"]
CMD ["/app/singbox-proxy-manager"]
