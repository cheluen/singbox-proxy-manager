# -----------------------------
# 镜像来源设置（必看）
# ghcr  = 使用 GHCR 预构建镜像（默认，启动最快）
# local = 使用本地源码构建镜像（更易做环境定制）
# 首次启动：复制本文件为同目录的 .env，设置 ADMIN_PASSWORD 后执行 docker compose up -d。
# local 模式需要源码构建；修改源码后执行 docker compose up -d --build sb-proxy-local。
# 切换模式前先执行 docker compose --profile ghcr --profile local down，避免同名容器冲突。
# -----------------------------
COMPOSE_PROFILES=ghcr
GHCR_IMAGE=ghcr.io/cheluen/singbox-proxy-manager:latest
LOCAL_IMAGE=singbox-proxy-manager:local
GO_MODULE_PROXY=https://proxy.golang.org,direct
GO_SUM_DB=sum.golang.org

# -----------------------------
# 基础运行配置
# -----------------------------
# Compose 通过 env_file 注入同目录 .env；二进制读取可执行文件同目录及工作目录的 .env。
# CONFIG_DIR 是进程看到的路径；下面使用容器内路径，二进制部署时需改为实际数据目录。
PORT=30000
BIND_ADDRESS=0.0.0.0
CONFIG_DIR=/app/config
CONFIG_VOLUME_HOST=./config
# 服务全局时区，默认 UTC+8（上海/香港）
TZ=UTC+8

# 新数据库首次启动必须设置非空管理员密码，与 BIND_ADDRESS 无关；最长 72 字节。
# 只有数据库已保存有效管理员密码时才可留空；不提供默认密码或空密码首次设密入口。
# 老库已有有效密码但未记录环境密码指纹时，首次设置本变量只记录指纹，不覆盖旧密码或撤销会话。
# 此后更改非空环境密码并重启才会覆盖数据库密码并撤销会话；环境值不变时保留面板内改密结果。
ADMIN_PASSWORD=

# 仅用于未内置内核的开发构建，填写外部 sing-box 可执行文件的路径。
SINGBOX_BINARY=
# 可选：额外传给 sing-box 的非敏感环境变量名，多个名称用逗号分隔
SINGBOX_ENV_ALLOWLIST=

# sing-box 配置校验：进程并发数 1-16；单次硬超时 100ms-2m（包含等待校验槽位）。
# 下面五项均传入 Compose 容器；留空、格式无效或超出范围时使用代码默认值。
SBPM_SINGBOX_CHECK_CONCURRENCY=4
SBPM_SINGBOX_CHECK_TIMEOUT=10s
# 上游 IP 检测：临时进程并发数 1-16；请求总时限 1s-5m（包含等待检测槽位）。
SBPM_UPSTREAM_CHECK_CONCURRENCY=3
SBPM_UPSTREAM_CHECK_TIMEOUT=30s
# 批量导入：候选预检至最终提交的校验总时限 100ms-2m，不包含此前的订阅抓取与展开阶段。
SBPM_BATCH_IMPORT_VALIDATION_TIMEOUT=45s

# 容器默认写入 stdout 以复用容器日志轮转；独立二进制可设为 file 或 both。
SBPM_SINGBOX_LOG_OUTPUT=stdout
SBPM_SINGBOX_LOG_MAX_BYTES=10485760
SBPM_SINGBOX_LOG_BACKUPS=3
SBPM_SINGBOX_RECOVERY_MAX_ATTEMPTS=5
SBPM_SINGBOX_RECOVERY_BASE_DELAY=1s
SBPM_SINGBOX_RECOVERY_MAX_DELAY=30s
SBPM_SINGBOX_RECOVERY_STABLE_WINDOW=1m

# 可选：允许跨域来源（逗号分隔），例如：
# CORS_ALLOWED_ORIGINS=https://panel.example.com,https://ops.example.com
CORS_ALLOWED_ORIGINS=

# 批量测 IP 并发（前端批量请求并发数；留空使用默认值）
SBPM_BATCH_CHECK_IP_CONCURRENCY=

# 节点列表首批与每次追加的行数，默认 120；0 表示全量展开，负数或格式无效时回退默认值。
SBPM_NODES_VIRTUAL_THRESHOLD=120

# 登录限速（防暴力破解）
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_BLOCK_SECONDS=600
LOGIN_MAX_CONCURRENT_CHECKS=2

# 管理 API 会话有效期（小时）
ADMIN_SESSION_TTL_HOURS=168

# 仅信任这些反向代理的客户端 IP 头（留空表示不信任任何代理）
# 例：TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# HTTP 服务器保护参数
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
API_MAX_BODY_BYTES=1048576

# -----------------------------
# 数据库配置（取以下 URL 变量中第一个非空值，不按变量名推断数据库类型）
# -----------------------------
# 1) URL 优先级：DATABASE_URL > POSTGRES_DATABASE_URL > POSTGRES_URL > PGSQL_DATABASE_URL
#    > PGSQL > MYSQL_DATABASE_URL > MYSQL。URL 的协议决定连接 PostgreSQL 还是 MySQL。
#    PostgreSQL 格式为 postgres:// 或 postgresql://；MySQL/TiDB 格式为 mysql://。
#    MySQL URL 如指向 sys/mysql/information_schema/performance_schema，会自动使用 test；也可用 MYSQL_DATABASE_NAME 覆盖。
DATABASE_URL=
POSTGRES_DATABASE_URL=
POSTGRES_URL=
PGSQL_DATABASE_URL=
# 兼容短变量名（可选）
PGSQL=
MYSQL_DATABASE_URL=
MYSQL=
MYSQL_DATABASE_NAME=
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=

# 管理进程使用数据库租约强制单实例；第二个实例会拒绝启动。
SBPM_INSTANCE_LEASE_DURATION=30s
SBPM_INSTANCE_LEASE_HEARTBEAT=10s

# 2) 仅在上述全部 URL 变量为空时检查 Turso；下面两项均非空则使用 Turso，否则使用本地 SQLite。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# -----------------------------
# 版本更新检查
# -----------------------------
# 面板加载或刷新请求 /api/version 时按需检查 GitHub Release；发现新版时显示向上箭头。
# TTL 是服务端查询缓存有效期，不是定时检查间隔；详细行为见 docs/configuration.md。
SBPM_UPDATE_CHECK_DISABLED=false
SBPM_UPDATE_CHECK_REPO=cheluen/singbox-proxy-manager
SBPM_UPDATE_CHECK_TTL=6h
SBPM_UPDATE_CHECK_TIMEOUT=5s
